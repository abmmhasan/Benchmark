# Manual-server fallback only. Docker records its automatically allocated URL
# in .benchmark-server.json, which takes precedence over this value.
base="http://127.0.0.1:8080/frameworks"

# Suggested benchmark defaults.
duration=30
connections=250

# Unversioned targets. Setup resolves the newest Composer release compatible
# with the installed PHP runtime; no framework version is pinned here.
frameworks_list="
cakephp
codeigniter
fatfree
flight
infbyte
kumbia
laravel
laravel-api
leaf
nette
pure-php
slim
symfony
yii-basic
"

# Dashboard categories. Pure PHP is a reference baseline, not a framework.
framework_categories="
cakephp:full-stack
codeigniter:full-stack
fatfree:micro
flight:micro
infbyte:full-stack
kumbia:full-stack
laravel:full-stack
laravel-api:full-stack
leaf:micro
nette:full-stack
pure-php:baseline
slim:micro
symfony:full-stack
yii-basic:full-stack
"

# Architectural style used for dashboard filtering and leader comparisons.
framework_architectures="
cakephp:mvc-hmvc
codeigniter:mvc-hmvc
fatfree:mvc-hmvc
flight:component-based
infbyte:component-based
kumbia:mvc-hmvc
laravel:mvc-hmvc
laravel-api:mvc-hmvc
leaf:component-based
nette:component-based
pure-php:baseline
slim:component-based
symfony:component-based
yii-basic:mvc-hmvc
"

# Composer package whose installed release represents each framework version.
framework_version_packages="
cakephp:cakephp/cakephp
codeigniter:codeigniter4/framework
fatfree:bcosca/fatfree-core
flight:flightphp/core
infbyte:infocyph/infbyte
kumbia:kumbia/framework
laravel:laravel/framework
laravel-api:laravel/framework
leaf:leafs/leaf
nette:nette/application
slim:slim/slim
symfony:symfony/framework-bundle
yii-basic:yiisoft/yii2
"
