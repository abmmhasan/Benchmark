# Manual-server fallback only. Docker records its automatically allocated URL
# in .benchmark-server.json, which takes precedence over this value.
base="http://127.0.0.1:8080/frameworks"

# Suggested benchmark defaults.
duration=30
connections=250

# Unversioned targets. Setup resolves the newest Composer release compatible
# with the installed PHP runtime; no framework version is pinned here.
frameworks_list="
cakephp
codeigniter
fatfree
fast-route
flight
hyperf
infbyte
infbyte-full
kumbia
laravel
laravel-api
leaf
nette
pure-php
slim
symfony
webrick-sharded
webrick-fused
yii-basic
"

# Execution model. The profiles are benchmarked and published separately:
# request-per-process Apache with OPcache, or a persistent Swoole worker.
framework_runtimes="
cakephp:opcache
codeigniter:opcache
fatfree:opcache
fast-route:opcache
flight:opcache
hyperf:swoole
infbyte:opcache
infbyte-full:opcache
kumbia:opcache
laravel:opcache
laravel-api:opcache
leaf:opcache
nette:opcache
pure-php:opcache
slim:opcache
symfony:opcache
webrick-sharded:opcache
webrick-fused:opcache
yii-basic:opcache
"

