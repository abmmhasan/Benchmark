# Manual-server fallback only. Docker records its automatically allocated URL
# in .benchmark-server.json, which takes precedence over this value.
base="http://127.0.0.1:8080/frameworks"

# Suggested benchmark defaults.
duration=30
connections=250

# Unversioned targets. Setup resolves the newest Composer release compatible
# with the installed PHP runtime; no framework version is pinned here.
frameworks_list="
cakephp
codeigniter
fatfree
flight
infbyte
kumbia
laravel
laravel-api
leaf
lumen
nette
pure-php
slim
symfony
yii-basic
"

# Dashboard categories. Pure PHP is a reference baseline, not a framework.
framework_categories="
cakephp:full-stack
codeigniter:full-stack
fatfree:micro
flight:micro
infbyte:modular
kumbia:full-stack
laravel:full-stack
laravel-api:modular
leaf:micro
lumen:micro
nette:modular
pure-php:baseline
slim:micro
symfony:modular
yii-basic:full-stack
"
