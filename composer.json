{
  "name": "abmmhasan/benchmark",
  "description": "Benchmarking library",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "abmmhasan",
      "email": "abmmhasan346@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "AbmmHasan\\Benchmark\\": "src/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4",
    "ext-curl": "*",
    "nunomaduro/termwind": "^2.4"
  },
  "scripts": {
    "lint": [
      "@php -l src/BenchmarkConfig.php",
      "@php -l src/BenchmarkConsole.php",
      "@php -l src/BenchmarkRunner.php",
      "@php -l src/ContainerStats.php",
      "@php -l src/HttpMethod.php",
      "@php -l src/PipingMode.php",
      "@php -l src/RequestBenchmark.php",
      "@php -l src/UnitBenchmark.php",
      "@php -l benchmarks/ComponentBench.php",
      "@php -l tests/run.php"
    ],
    "test": "@php tests/run.php",
    "bench": "phpbench run --report=aggregate",
    "bench:quick": "phpbench run --report=aggregate --iterations=3 --revs=100",
    "check": [
      "@lint",
      "@test"
    ]
  },
  "require-dev": {
    "phpbench/phpbench": "^1.7"
  }
}
